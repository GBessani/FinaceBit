# Supabase — copie do painel: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service Role Key — necessária para excluir contas (Settings > API > service_role)
# NUNCA exponha esta chave no frontend — apenas em Server Components / Route Handlers
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Groq AI — para o assistente financeiro
GROQ_API_KEY=sua_groq_key_aqui
